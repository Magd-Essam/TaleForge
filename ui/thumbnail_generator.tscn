[gd_scene format=3 uid="uid://84dny30uqiww"]

[sub_resource type="GDScript" id="GDScript_xcs7k"]
script/source = "extends Node3D

@onready var viewport = $SubViewport
@onready var model_holder = $SubViewport/ModelHolder
@onready var camera = $SubViewport/Camera3D

# Cache thumbnails so we don't regenerate them
var thumbnail_cache = {}

func get_thumbnail(model_path: String) -> ImageTexture:
	# Return cached version if available
	if thumbnail_cache.has(model_path):
		return thumbnail_cache[model_path]
	
	# Clear previous model
	for child in model_holder.get_children():
		child.queue_free()
	
	# Load model
	var model_scene = load(model_path)
	if not model_scene:
		return null
	
	var model = model_scene.instantiate()
	model_holder.add_child(model)
	
	# Wait for model to be ready
	await get_tree().process_frame
	await get_tree().process_frame
	
	# Auto fit camera to model
	var aabb = get_model_aabb(model)
	if aabb.size != Vector3.ZERO:
		var center = aabb.get_center()
		var size = max(aabb.size.x, max(aabb.size.y, aabb.size.z))
		camera.position = center + Vector3(size, size * 0.8, size * 1.2)
		camera.look_at(center)
	
	# Force render
	viewport.render_target_update_mode = SubViewport.UPDATE_ONCE
	await get_tree().process_frame
	await get_tree().process_frame
	
	# Capture image
	var img = viewport.get_texture().get_image()
	if img == null:
		return null
	
	var tex = ImageTexture.create_from_image(img)
	
	# Cache it
	thumbnail_cache[model_path] = tex
	
	# Clean up model
	for child in model_holder.get_children():
		child.queue_free()
	
	return tex

func get_model_aabb(node: Node) -> AABB:
	var aabb = AABB()
	if node is MeshInstance3D:
		aabb = node.get_aabb()
	for child in node.get_children():
		var child_aabb = get_model_aabb(child)
		if aabb.size == Vector3.ZERO:
			aabb = child_aabb
		elif child_aabb.size != Vector3.ZERO:
			aabb = aabb.merge(child_aabb)
	return aabb
"

