; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="VTT Open"
run/main_scene="res://ui/splash_screen.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")
boot_splash/image="uid://btvfyii38owro"
config/icon="uid://dijb4daq4sm0h"
boot_splash/minimum_display_time=5000

[autoload]

AssetLibrary="*uid://cvgjnncgsisfv"
DefaultLibrary="*uid://s2vvcuox0fsv"
AabbUtil="*res://Scripts/aabb_util.gd"
GameManager="*res://global/game_manager.gd"
SettingsManager="*res://global/settings_manager.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="canvas_items"

[editor]

movie_writer/movie_file="D:/Godot/test/clips/.avi"
movie_writer/fps=30

[editor_plugins]

enabled=PackedStringArray()

[physics]

3d/physics_engine="Jolt Physics"

[plugins]

ai_assistant_hub/options/debug_mode=0
ai_assistant_hub/llm_api="gemini_api"
ai_assistant_hub/preferences/thinking_target=0
ai_assistant_hub/preferences/skip_greeting=false
ai_assistant_hub/preferences/always_scroll_to_bottom=false
ai_assistant_hub/preferences/audio_hints=true

[rendering]

rendering_device/driver.windows="d3d12"
gl_compatibility/driver.windows="opengl3_angle"
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
